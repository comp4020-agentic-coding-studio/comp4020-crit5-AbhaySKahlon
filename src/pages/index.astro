---
import "../styles/styles.css";
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Downhill</title>
    <meta
      name="description"
      content="A hand-drawn downhill skiing game: steer around rocks and gates, jump the three-rock walls, and race to beat your local top-5 leaderboard."
    />

    <!--
      The link-preview card: public/card.png, 1200x630 --- replace it. The URL
      resolves against this page, like any link. No og:title/og:description:
      scrapers fall back to the <title> and description above.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:image" content="./card.png" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header>
      <nav aria-label="Primary">
        <a href="./">Downhill</a>
      </nav>
    </header>
    <main>
      <h1>Downhill</h1>
      <canvas id="game" aria-label="Downhill skiing game"></canvas>
      <p id="score-hud" class="score-hud" hidden></p>
      <div id="end-panel" class="end-panel" hidden>
        <p id="end-message" class="end-message"></p>
        <p id="end-score" class="end-score"></p>
        <div class="leaderboard">
          <h2>Local best runs</h2>
          <p class="leaderboard-note">Saved on this device only — not an online leaderboard.</p>
          <ol id="leaderboard-list"></ol>
        </div>
      </div>
    </main>
    <script src="../scripts/main.ts"></script>
  </body>
</html>
